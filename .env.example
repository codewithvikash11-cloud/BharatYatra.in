# Copy to ignored root .env for local development. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin-only credentials are read by the server; never prefix them with NEXT_PUBLIC_.
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set locally from Supabase Connect settings. DATABASE_URL is for app runtime
# (prefer the Supavisor session pooler for hosted server processes); DIRECT_URL
# is the direct PostgreSQL connection for Prisma CLI introspection/migrations.
# Keep both values private. Do not copy the service-role key into either URL.
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configure only after selecting an object storage / maps provider.
MEDIA_STORAGE_BUCKET=
MAPS_PROVIDER=
MAPS_API_KEY=

# Optional: add Firebase Admin credentials through your deployment secret manager.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
