{
  "name": "bharatyatra",
  "version": "0.1.0",
  "private": true,
  "description": "BharatYatra India travel discovery and trip-planning monorepo",
  "workspaces": ["apps/web", "apps/admin", "apps/api", "apps/mobile", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@bharatyatra/web",
    "dev:web": "npm run dev --workspace=@bharatyatra/web",
    "dev:admin": "npm run dev --workspace=@bharatyatra/admin",
    "dev:api": "npm run dev --workspace=@bharatyatra/api",
    "dev:mobile": "npm run android --workspace=@bharatyatra/mobile",
    "build": "npm run build --workspace=@bharatyatra/web && npm run build --workspace=@bharatyatra/admin",
    "check": "npm run check --workspaces --if-present"
  },
  "engines": { "node": ">=22.12.0", "npm": ">=10.9.0" }
}
